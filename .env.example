# Pelo menos 12 caracteres.
ADMIN_PASSWORD=change-this-to-a-long-random-password

# URL que o switch consegue alcançar.
INFORM_URL=http://192.0.2.10:8789/inform

# Opcional, mas recomendado: limita a aplicação a um equipamento.
SWITCH_MAC=

AUTO_ADOPT=0
BOOTSTRAP_KEY_FILE=

# Descoberta UDP opcional. A gestão e a adoção manual por IP/MAC não dependem dela.
DISCOVERY_ENABLED=0
DISCOVERY_TARGETS=
DISCOVERY_INTERVAL_MS=30000

# Recetor passivo. Publique 10002/UDP no host e encaminhe para aqui os
# broadcasts do switch quando a aplicação não está na mesma LAN.
DISCOVERY_LISTEN_ENABLED=0
DISCOVERY_LISTEN_PORT=10001
DISCOVERY_LISTEN_PUBLISH=10002

# Após reset, tenta o último IP guardado se não chegar um anúncio UDP.
RECOVERY_SAVED_ADDRESS_DELAY_MS=12000
